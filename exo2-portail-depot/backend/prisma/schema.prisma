// Prisma schema of the deposit portal.
//
// Three modelling decisions cannot be guessed by reading the fields:
//
// 1. A request's STATUS is NOT a column. "expired" depends on the clock: a
//    column would stay at "pending" after expiry for as long as no job flips
//    it, and the dashboard would lie. It is computed on read from expiresAt and
//    the count of received items. Same reason for "number of expected items",
//    which is a count(RequestedItem).
//
// 2. There is NO AccessLog table. The exercise statement classifies the audit
//    log as a bonus (issue G2): the table would be written by nobody and read
//    by nobody, and its cost of addition will be the same later. PublicLink
//    prepares the ground, and G2 will attach its events to a specific link.
//
// 3. UploadedFile.mimeType is a String, not an enum. The statement fixes
//    PDF/JPG/PNG, but C2 requires the allowed types to be *configurable*: a
//    Postgres enum would force a migration to change a validation list. The
//    allowlist and the maximum size live in the configuration; the database
//    merely records what was deposited.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // engineType "client": no binary query engine, everything goes through the
  // pg adapter. One fewer native dependency to keep alive across
  // `pnpm prune --prod` and the two stages of the image.
  engineType   = "client"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // No `url` here: Prisma 7 forbids it in the schema (P1012). The connection
  // string reaches the CLI through prisma.config.ts, and the runtime through
  // @prisma/adapter-pg (see src/prisma/prisma.service.ts). Both read the same
  // DATABASE_URL, hence a single source of truth.
}

/// The lawyer, the portal's only authenticated actor. The client stays
/// anonymous: they only have a link and a PIN, and therefore exist in no table.
model Lawyer {
  id String @id @default(uuid())

  name String
  /// Lowercased by the code before writing: without that, "Martin@x.fr" and
  /// "martin@x.fr" would create two distinct accounts.
  email String @unique
  /// argon2id, PHC string (salt and parameters included). Never in clear, not
  /// even transiently -- see src/crypto/secrets.ts.
  passwordHash String

  createdAt DateTime @default(now())

  requests      DepositRequest[]
  refreshTokens RefreshToken[]
}

/// One link in a rotation chain. A family is the chain issued by one login;
/// presenting a link that has already been rotated means a copy is circulating,
/// so the whole family is revoked.
///
/// Rotated rows are KEPT rather than deleted: their presence is the only thing
/// that makes a reuse recognisable. Deleted, a stolen token would look exactly
/// like an unknown one.
model RefreshToken {
  id String @id @default(uuid())

  /// SHA-256 of the token, never the token itself -- it is a bearer credential.
  /// A fast hash suffices: 256 bits cannot be guessed, and the lookup must stay
  /// a single indexed read. Same reasoning as PublicLink.tokenHash.
  tokenHash String @unique

  /// The chain issued by one login. Rotation copies it; revocation targets it.
  familyId String

  /// CEILING of the session, dated from the login and COPIED unchanged on every
  /// rotation. Without it, a chain that rotates every 15 minutes never expires.
  expiresAt DateTime

  /// IDLE deadline, RECOMPUTED on every rotation. Closes a session nobody uses
  /// -- an abandoned workstation, a cookie copied and kept for later.
  ///
  /// Beware the asymmetry: expiresAt is copied, this one is recomputed. Treating
  /// them alike removes one of the two protections, and nothing would say so.
  idleExpiresAt DateTime

  /// Non-null once rotated, logged out, or killed by a reuse detection.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([lawyerId])
}

/// A request for documents addressed to a client, for example
/// "Dossier Martin, pieces 2026".
model DepositRequest {
  id String @id @default(uuid())

  title     String
  createdAt DateTime @default(now())

  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  items RequestedItem[]
  links PublicLink[]

  @@index([lawyerId])
}

/// The expiring public link protected by a PIN. A dedicated table rather than
/// three columns on DepositRequest, for two reasons:
///
/// - regenerating a link creates a row and revokes the previous one, so it is
///   structurally impossible for an old PIN to stay valid on a new link -- the
///   invariant belongs to the schema, not to applicative discipline;
/// - the link history exists from the start, whereas extracting it after the
///   fact would have required a data migration plus a rewrite of every query
///   touching the token, the PIN or the expiry.
model PublicLink {
  id String @id @default(uuid())

  /// SHA-256 of the token, never the token itself: it is a bearer credential,
  /// just like a password. In clear, a database leak would hand over every
  /// active link. SHA-256 rather than argon2id: argon2 exists to slow down
  /// brute-forcing a low-entropy secret, whereas the token carries 256 bits and
  /// cannot be guessed -- a fast hash suffices and keeps the lookup indexed.
  tokenHash String @unique
  /// argon2id, like the password. A 4-digit PIN is the weakest secret in the
  /// system: it deserves the slowest derivation function.
  pinHash   String

  expiresAt DateTime
  createdAt DateTime  @default(now())
  /// Non-null = link replaced or revoked. A single active link per request, via
  /// a partial unique index added by hand in the migration (Prisma cannot
  /// express a conditional index):
  ///
  ///   CREATE UNIQUE INDEX "PublicLink_requestId_active_key"
  ///     ON "PublicLink" ("requestId") WHERE "revokedAt" IS NULL;
  ///
  /// Not to be lost when regenerating a migration.
  revokedAt DateTime?

  requestId String
  request   DepositRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// An expected document, for example "Carte d'identite". No status column:
/// "received" means an UploadedFile is attached to it.
model RequestedItem {
  id String @id @default(uuid())

  label     String
  createdAt DateTime @default(now())

  requestId String
  request   DepositRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  file UploadedFile?

  @@index([requestId])
}

/// The file actually deposited. No direct foreign key to DepositRequest: it is
/// reached through RequestedItem, and a second relation would open the door to
/// a file whose item belongs to another request.
model UploadedFile {
  id String @id @default(uuid())

  /// Object key in MinIO. Prefixed per request
  /// (requests/<requestId>/items/<itemId>/...) so that deleting a request can
  /// erase the objects by prefix, including after the SQL cascade has already
  /// removed the rows. See buildStorageKey().
  storageKey String @unique
  /// Name supplied by the client, kept for display only: it is never used as a
  /// path.
  originalName String
  mimeType     String
  sizeBytes    Int
  status       UploadStatus @default(pending)

  createdAt DateTime @default(now())

  /// Unique: an expected item carries at most one file. A new deposit replaces
  /// the previous one, MinIO object included -- there is no versioning.
  requestedItemId String        @unique
  requestedItem   RequestedItem @relation(fields: [requestedItemId], references: [id], onDelete: Cascade)
}

/// `failed` exists from the start because C4 (real type checking and antivirus
/// scan) needs it: a rejected file must stay visible on both sides rather than
/// disappear.
enum UploadStatus {
  pending
  complete
  failed
}
