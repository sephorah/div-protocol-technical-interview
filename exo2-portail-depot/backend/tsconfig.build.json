{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    // prisma.config.ts n'est lu que par le CLI Prisma, qui le charge via jiti.
    // S'il entrait dans la compilation, le rootDir deduit par tsc passerait de
    // src/ a la racine du paquet : la sortie deviendrait dist/src/main.js et
    // `node dist/main` ne trouverait plus rien. C'est arrive une fois.
    "prisma.config.ts"
  ]
}
