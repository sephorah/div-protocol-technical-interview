{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    // prisma.config.js est du JavaScript lu uniquement par le CLI Prisma.
    // S'il entrait dans la compilation, le rootDir deduit par tsc passerait de
    // src/ a la racine du paquet : la sortie deviendrait dist/src/main.js et
    // `node dist/main` ne trouverait plus rien.
    "prisma.config.js"
  ]
}
