# Copier en `.env` a la racine du depot et renseigner les valeurs. `.env` est
# gitignore ; ne jamais mettre de valeur reelle dans ce fichier-ci.
#
# `./install.sh` genere ce fichier automatiquement s'il est absent, avec des
# secrets aleatoires, et n'ecrase jamais un .env existant.
#
# A LA RACINE, et pas dans infra/ : l'API le lit aussi quand elle tourne sur la
# machine. Voir docs/exploitation.md § .env.

# --- Version des images ---------------------------------------------------
# PAS une cle a renseigner : le defaut vit dans infra/docker-compose.yml
# (actuellement 0.4.0), parce que la version appartient au code et non a la
# machine. Renseignee ici, install.sh ne la reecrirait jamais et la machine
# resterait figee sur une version perimee.
#
# Le retour arriere est ponctuel, sur la ligne de commande :
#   IMAGE_TAG=0.3.0 docker compose -f infra/docker-compose.yml \
#     --env-file .env up -d
#
# Chaque version anterieure retire quelque chose EN SILENCE, la pile
# demarrant normalement : 0.3.0 n'a aucun ecran au-dela de la connexion ni
# aucune metrique ; 0.2.0 ecrit le jeton de depot en clair dans les journaux ;
# 0.1.0 est anterieure a l'authentification.
# IMAGE_TAG=

# --- API ----------------------------------------------------------------
# Sans repli : l'API refuse de demarrer si elles manquent, plutot que d'ecouter
# hors de la plage attribuee (21600-21699) sur une machine partagee. Elles sont
# aussi ecrites en dur dans infra/nginx/, qui ne lit pas l'environnement.
PORT=21610
API_PREFIX=/api/v1

# Interface d'ecoute. 127.0.0.1 sur la machine ; le compose surcharge a 0.0.0.0
# dans le conteneur, ou le reseau est isole et nginx doit joindre le service.
BIND_ADDRESS=127.0.0.1

# --- Origine publique ---------------------------------------------------
# L'adresse a laquelle un client joint le portail : l'API compose le lien de
# depot a partir d'elle. Une ORIGINE seulement, ni chemin ni parametres.
# install.sh la remplace par https://$DOMAIN quand DOMAIN est renseigne, mais
# jamais une valeur choisie a la main.
PUBLIC_BASE_URL=http://127.0.0.1:21600

# --- Domaine et TLS ------------------------------------------------------
# CES TROIS VARIABLES NE SERVENT QU'A LA MACHINE DE DEPLOIEMENT, et seul
# install.sh les lit — ni compose ni l'application. Leur absence de
# infra/docker-compose.yml n'est donc pas un oubli. Laissees vides, le portail
# reste en clair sur http://127.0.0.1:21600.
# Detail : docs/exploitation.md § TLS.

# L'INTERRUPTEUR. Le nom doit resoudre publiquement vers cette machine : le
# challenge HTTP-01 arrive sur son port 80.
DOMAIN=

# Destinataire des avis d'expiration de Let's Encrypt. Obligatoire des que
# DOMAIN est renseigne : c'est le seul canal d'alerte si le renouvellement
# automatique cesse de fonctionner.
ACME_EMAIL=

# `1` pour l'endpoint de TEST : quotas larges, certificat qu'aucun navigateur ne
# reconnait. Ce n'est pas optionnel — la production plafonne a 5 certificats
# identiques par semaine, donc quatre essais rates grillent le domaine pour sept
# jours. Repasser a `0` ensuite : install.sh detecte le certificat de test, le
# supprime et emet le vrai.
ACME_STAGING=

# --- Base de donnees ----------------------------------------------------
# L'URL de connexion est ASSEMBLEE a partir de ces cinq variables, avec
# encodeURIComponent : aucun caractere n'est a echapper, n'importe quel mot de
# passe fonctionne. Seuls DB_HOST et DB_PORT changent en conteneur.
#
# DB_USER et DB_NAME sont des noms, pas des secrets : renseignes ici, sinon un
# `cp .env.example .env` a la main echoue sur une valeur indevinable.
DB_HOST=127.0.0.1
DB_PORT=21632
DB_USER=portail
DB_PASSWORD=
DB_NAME=portail_depot

# Changer DB_PASSWORD apres coup ne modifie PAS le mot de passe d'un volume
# Postgres deja cree : il faut un `down -v`, qui detruit les donnees.

# Optionnelle : renseignee, elle l'emporte sur les cinq variables ci-dessus.
# Utile pour une base managee ou de CI.
# DATABASE_URL=

# --- Stockage objet -----------------------------------------------------
# Le nommage est STORAGE_ et non MINIO_ a dessein : MinIO est une implementation
# de S3, pas le contrat. La valeur ci-dessous est celle de `pnpm db:up` ; le
# compose la surcharge en http://minio:9000.
STORAGE_ENDPOINT=http://127.0.0.1:21690

# MinIO ignore la region, le SDK S3 exige qu'elle soit renseignee.
STORAGE_REGION=us-east-1

# Cree par le conteneur minio-init, jamais par l'API : celle-ci constate son
# existence au demarrage et echoue sinon, donc une faute de frappe ici ne cree
# pas un bucket parallele en silence.
STORAGE_BUCKET=portail-depot

# Utilisateur applicatif, cree par minio-init, limite au seul bucket ci-dessus
# (infra/minio/app-policy.json). Generes par ./install.sh.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Administration MinIO -----------------------------------------------
# Le prefixe dit qui lit la variable : MINIO_* n'est JAMAIS lu par
# l'application. Ces deux valeurs doivent differer de STORAGE_ACCESS_KEY —
# MinIO refuse de creer un utilisateur portant le nom du root.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Observabilite -------------------------------------------------------
# Mot de passe du compte admin de Grafana, lu par le SEUL conteneur grafana.
# ATTENTION : Grafana ne le lit qu'a l'INITIALISATION de son volume ; le changer
# ensuite ne change rien sans detruire grafana_data.
GRAFANA_ADMIN_PASSWORD=

# --- Authentification avocat --------------------------------------------
# 32 caracteres minimum. Qui connait JWT_SECRET forge un jeton pour n'importe
# quel avocat, et l'attaque est HORS LIGNE : un seul jeton intercepte suffit,
# sans jamais appeler l'API.
JWT_SECRET=

# La meme chose pour la session du client anonyme, et elle doit etre DIFFERENTE
# de JWT_SECRET : l'API refuse de demarrer sinon (RFC 8725 § 3.8). La faire
# tourner ferme toutes les sessions de depot sans deconnecter un avocat.
CLIENT_JWT_SECRET=

# Jeton d'ACCES, unite obligatoire (60s, 15m, 2h) : un nombre nu vaut des
# secondes et une chaine numerique des millisecondes, donc « 900 » signifierait
# 15 minutes ou 0,9 seconde selon une paire de guillemets. 15 minutes est la
# fenetre pendant laquelle un jeton vole reste utilisable — un JWT signe ne se
# revoque pas.
JWT_EXPIRES=15m

# PLAFOND de la session, compte depuis la connexion : le rafraichissement ne le
# repousse jamais. Contrairement au jeton d'acces, la session est revocable.
SESSION_EXPIRES=7d

# INACTIVITE toleree, repoussee a chaque rafraichissement. Trois jours plutot
# que deux : une session du vendredi soir survit au lundi matin. Doit rester
# INFERIEURE a SESSION_EXPIRES, sinon elle ne se declencherait jamais — et le
# demarrage echoue en le disant.
SESSION_IDLE_EXPIRES=3d

# --- Compte avocat de demonstration -------------------------------------
# Lues par `node dist/seed.js` uniquement. Le seed est idempotent, et il
# retrouve le compte par la demande qu'il possede, jamais par son adresse :
# changer l'adresse RENOMME le compte, il n'en cree pas un second.
#
# example.com et non exemple.fr : la RFC 2606 reserve example.com pour cet
# usage, exemple.fr est un domaine reellement enregistrable.
SEED_LAWYER_EMAIL=avocat@example.com
SEED_LAWYER_NAME=Maitre Dupont

# Un secret, mais stocke en clair parce qu'il faut pouvoir le RELIRE : c'est ce
# que le seed imprime a l'evaluateur, et un hash ne se relit pas. D'ou le
# chmod 600 sur .env. Le changer puis relancer ./install.sh met a jour le compte.
SEED_LAWYER_PASSWORD=
