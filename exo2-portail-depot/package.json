{
  "name": "portail-depot",
  "version": "0.0.0",
  "private": true,
  "description": "Orchestration des deux applications (backend NestJS, frontend Vite).",
  "scripts": {
    "install:all": "pnpm -C backend install && pnpm -C frontend install",
    "db:up": "docker compose -f infra/docker-compose.dev.yml --env-file .env up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml --env-file .env down",
    "stack:pull": "docker compose -f infra/docker-compose.yml --env-file .env pull",
    "stack:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "stack:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "stack:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "db:migrate": "pnpm -C backend run db:migrate",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm -C backend run build",
    "build:frontend": "pnpm -C frontend run build",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:backend": "pnpm -C backend run start:dev",
    "dev:frontend": "pnpm -C frontend run dev",
    "start": "pnpm run \"/^start:/\"",
    "start:backend": "pnpm -C backend run start:prod",
    "start:frontend": "pnpm -C frontend run start",
    "test": "pnpm -C backend run test",
    "test:e2e": "pnpm -C backend run test:e2e",
    "test:integration": "pnpm -C backend run test:integration",
    "lint": "pnpm -C backend run lint && pnpm -C frontend run lint"
  },
  "packageManager": "pnpm@11.20.0"
}
