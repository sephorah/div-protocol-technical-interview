# Dependances
node_modules/

# Sorties de build
dist/
build/
*.tsbuildinfo

# Client Prisma genere depuis prisma/schema.prisma. Regenere par
# `pnpm build` (et par `pnpm db:generate`), donc jamais versionne :
# un client commite finit desynchronise du schema sans que rien ne le signale.
backend/src/generated/

# Tests
coverage/

# Environnement — ne jamais committer de secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Outils
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.cache/

# Captures Playwright MCP, hors depot
.playwright-mcp/

# Journaux de session (/export). Les transcriptions rendues sont versionnees :
# le livrable les demande, et elles sont caviardees (voir ai-logs/README.md).
# Le format machine du meme export ne l'est pas : signatures de thinking,
# requestId, comptes de tokens — rien qu'un relecteur ouvre, et un canal de
# fuite de plus a surveiller a chaque nouvel export.
ai-logs/*.jsonl

